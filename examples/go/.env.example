# Every variable can instead be read from a file: set NAME_FILE to its path, for example
# GTR_SECRET_KEY_FILE=/run/secrets/gtr_secret_key for Docker or Kubernetes secrets.

# HTTP server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# compose.yaml publishes the port on 127.0.0.1 for a reverse proxy on the same host. Set 0.0.0.0
# only when the proxy runs elsewhere and the port is firewalled to it.
# BIND_ADDRESS=127.0.0.1

# Secret key entered in Sumsub dashboard → Marketplace → GTR → Settings, at least 16 characters.
# Sumsub signs every request with it (X-Payload-Digest header). To rotate it without downtime, put the
# new key here and the old one into SUMSUB_SECRET_KEY_PREVIOUS, change it in the dashboard, then
# remove the old one.
SUMSUB_SECRET_KEY=
SUMSUB_SECRET_KEY_PREVIOUS=

# Sumsub API token from Marketplace → GTR → "Generate API token". The gateway uses it to forward
# GTR callbacks (incoming Travel Rule requests). Leave both empty to run outbound-only.
SUMSUB_API_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_APP_SECRET=

# GTR API origin: https://uat-platform.globaltravelrule.com for UAT, used with the Sumsub Sandbox,
# or https://platform.globaltravelrule.com for production.
GTR_API_URL=

# From the api_key.csv file issued in the GTR portal.
GTR_VASP_CODE=
GTR_ACCESS_KEY=
GTR_SECRET_KEY=

# Mutual-TLS client certificate issued by GTR for the API key.
GTR_CLIENT_CERT_PATH=./secrets/certificate.p12
GTR_CLIENT_CERT_PASSWORD=
# Optional CA bundle, only if the GTR environment uses a private CA.
# GTR_CA_CERT_PATH=./secrets/gtr-ca.pem

# Base64 Ed25519 private key registered with GTR for PII encryption:
# either the 32-byte seed or the 64-byte seed||publicKey form.
GTR_PRIVATE_KEY=

# Optional PGP payload encryption (contract §2.1). Generate the key pair in Marketplace → GTR → Settings
# (the private key is shown once) and copy the Sumsub public key shown in the same card. Both are
# ASCII-armored; a single-line value with literal \n sequences is accepted. Set both or neither.
# To rotate the key, put the new private key after the old one in GATEWAY_PGP_PRIVATE_KEY, upload the
# new public key in the dashboard, then remove the old private key.
GATEWAY_PGP_PRIVATE_KEY=
GATEWAY_PGP_PRIVATE_KEY_PASSPHRASE=
SUMSUB_PGP_PUBLIC_KEY=
